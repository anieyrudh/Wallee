{
  "permissions": {
    "allow": [
      "Bash(ssh *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(redis-cli *)",
      "Bash(pytest *)",
      "Bash(git *)",
      "Bash(tmux *)",
      "Bash(scp *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(curl *)",
      "Bash(systemctl status *)",
      "Bash(journalctl *)",
      "Bash(lsusb)",
      "Bash(i2cdetect *)",
      "Read(**/*)",
      "Edit(**/*.py)",
      "Edit(**/*.md)",
      "Edit(**/*.json)",
      "Edit(**/*.sql)",
      "Edit(**/*.txt)",
      "Edit(**/*.toml)",
      "Edit(**/*.yaml)",
      "Edit(**/*.cfg)",
      "Edit(**/*.html)",
      "Edit(**/*.css)",
      "Edit(**/*.js)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo rm *)",
      "Bash(sudo reboot*)",
      "Bash(sudo shutdown*)",
      "Edit(.env)",
      "Edit(.env.*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Wallee build needs attention\" with title \"Claude Code\"'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m pytest tests/ -x -q --tb=short 2>&1 | tail -10 || true"
          }
        ]
      }
    ]
  }
}
