[Unit]
Description=Wallee independent safety watchdog
# Starts before, and is required by, the main runtime: the watchdog must be
# up before any control loop can dispatch, and if the watchdog dies the main
# runtime is taken down with it (Requires= in wallee-main.service).
Before=wallee-main.service

[Service]
Type=simple
WorkingDirectory=/opt/wallee
ExecStart=/opt/wallee/venv/bin/python -m wallee.safety_watchdog
EnvironmentFile=/etc/wallee/safety.env
Restart=always
RestartSec=2
User=wallee-safety
Group=wallee-safety
# Hardening: the watchdog needs almost nothing.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/wallee
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=128M

[Install]
WantedBy=multi-user.target
