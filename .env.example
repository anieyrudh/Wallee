# ============================================================
# Wallee — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. Only .env.example is committed.
# ============================================================

# === LLM (agent running on Pi calls this) ===
OPENROUTER_API_KEY=               # Get from https://openrouter.ai/keys
OPENROUTER_MODEL=google/gemini-3.1-pro-preview
OPENROUTER_ENABLE_WEB_SEARCH=true

# === Redis (whiteboard — runs on Pi) ===
REDIS_URL=redis://localhost:6379

# === Device packs to load (comma-separated) ===
# Available: host_pi, prusa_link, prusa_metrics, prusa_serial, pi_cameras
# Default: host_pi (if not set)
DEVICE_PACKS=host_pi,prusa_link,prusa_metrics,prusa_serial,pi_cameras

# === Prusa (optional — only needed if prusa_link pack is enabled) ===
PRUSALINK_HOST=                   # Printer IP (e.g., 192.168.1.50)
PRUSALINK_API_KEY=                # PrusaLink local API key

# === Telegram (optional) ===
TELEGRAM_BOT_TOKEN=               # From @BotFather on Telegram
TELEGRAM_CHAT_ID=                 # Your chat ID for notifications

# === Paths (on the Pi) ===
WALLEE_DATA_DIR=/var/lib/wallee   # Ledger, diary, outbox
WALLEE_LOG_DIR=/var/log/wallee    # Logs

# === Agent behavior ===
AGENT_POLL_INTERVAL_S=5
AGENT_HEARTBEAT_INTERVAL_S=1
AGENT_HEARTBEAT_TTL_S=3
AGENT_MIN_CHECK_INTERVAL_S=30
AGENT_MAX_CHECK_INTERVAL_S=120
AGENT_MAX_CHECK_INTERVAL_IDLE_S=300
AGENT_DEFAULT_CHECK_INTERVAL_S=60
AGENT_LAST_DECISION_TTL_S=600
ENGINE_POLL_INTERVAL_S=0.5
ENGINE_APPROVAL_TIMEOUT_S=300
HUMAN_INTENT_TTL_S=600
HUMAN_URGENT_TTL_S=600
HUMAN_IMAGE_TTL_S=600
HUMAN_ESTOP_TTL_S=600
DEFAULT_MAX_PROPOSAL_AGE_MS=30000
TELEGRAM_ALLOWED_USER_IDS=

# === Dashboard ===
DASHBOARD_PORT=8081
