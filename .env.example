# ============================================================
# Wallee — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. Only .env.example is committed.
# ============================================================

# === LLM (agent running on Pi calls this) ===
OPENROUTER_API_KEY=               # Get from https://openrouter.ai/keys
OPENROUTER_MODEL=
LLM_TEMPERATURE=
VISION_MODEL=

# === Redis (whiteboard — runs on Pi) ===
REDIS_URL=

# === Device packs to load (comma-separated) ===
# Available: host_pi, prusa_link, prusa_metrics, prusa_serial, pi_cameras
# Default: host_pi (if not set)
DEVICE_PACKS=

# === Prusa (optional — only needed if prusa_link pack is enabled) ===
PRUSALINK_HOST=                   # Printer IP (e.g., 192.168.1.50)
PRUSALINK_API_KEY=                # PrusaLink local API key

# === Telegram (optional) ===
TELEGRAM_BOT_TOKEN=               # From @BotFather on Telegram
TELEGRAM_CHAT_ID=                 # Your chat ID for notifications

# === Paths (on the Pi) ===
WALLEE_DATA_DIR=                  # Ledger, diary, outbox
WALLEE_LOG_DIR=                   # Logs

# === Agent behavior ===
AGENT_POLL_INTERVAL_S=
AGENT_HEARTBEAT_INTERVAL_S=
AGENT_HEARTBEAT_TTL_S=
AGENT_MIN_CHECK_INTERVAL_S=
AGENT_MAX_CHECK_INTERVAL_S=
AGENT_MAX_CHECK_INTERVAL_IDLE_S=
AGENT_DEFAULT_CHECK_INTERVAL_S=
AGENT_LAST_DECISION_TTL_S=
ENGINE_POLL_INTERVAL_S=
ENGINE_APPROVAL_TIMEOUT_S=
HUMAN_INTENT_TTL_S=
HUMAN_URGENT_TTL_S=
HUMAN_IMAGE_TTL_S=
HUMAN_ESTOP_TTL_S=
DEFAULT_MAX_PROPOSAL_AGE_MS=
TELEGRAM_ALLOWED_USER_IDS=

# === Dashboard ===
DASHBOARD_PORT=
