# Wallee v6 environment example
#
# This file documents the lean v6 runtime only. For the Prusa Core One+ pack,
# prefer the canonical `PRUSA_CORE_ONE_*` names. Exact v5-compatible aliases are
# supported only for:
# - `PRUSALINK_HOST` -> `PRUSA_CORE_ONE_HOST`
# - `PRUSALINK_API_KEY` -> `PRUSA_CORE_ONE_API_KEY`
# If both are set, the v6 name wins.

# Core runtime
WALLEE_DATA_DIR=.runtime
WALLEE_ENABLED_PACKS=sim_printer,sim_arm
WALLEE_SIMULATION=1
WALLEE_PLANNER_BACKEND=heuristic
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
WALLEE_REASONING_EFFORT=low
WALLEE_FRONTIER_LIMIT=8
WALLEE_DELTA_LIMIT_PER_DEVICE=3
WALLEE_APPROVAL_TTL_SECONDS=120
WALLEE_HEARTBEAT_TIMEOUT_SECONDS=3
WALLEE_AUTO_APPROVE_LOW=1
WALLEE_SAFE_TO_UNLOAD_TEMP_C=35.0

# Prusa Core One+ reference pack
PRUSA_CORE_ONE_HOST=
PRUSA_CORE_ONE_API_KEY=
PRUSA_CORE_ONE_HTTP_TIMEOUT_S=2.0
PRUSA_CORE_ONE_FILE_ACTION_LIMIT=2
PRUSA_CORE_ONE_STATE_TRANSITION_TIMEOUT_S=6.0
PRUSA_CORE_ONE_ENABLE_METRICS=1
PRUSA_CORE_ONE_METRICS_BIND_HOST=0.0.0.0
PRUSA_CORE_ONE_METRICS_PORT=8514
PRUSA_CORE_ONE_ENABLE_SERIAL=0
PRUSA_CORE_ONE_SERIAL_PORT=
PRUSA_CORE_ONE_SERIAL_BAUD=115200
PRUSA_CORE_ONE_SERIAL_TIMEOUT_S=1.0
PRUSA_CORE_ONE_SERIAL_POLL_INTERVAL_S=15.0
PRUSA_CORE_ONE_SERIAL_BACKOFF_S=30.0
PRUSA_CORE_ONE_SAFE_NOZZLE_TOUCH_C=50.0
