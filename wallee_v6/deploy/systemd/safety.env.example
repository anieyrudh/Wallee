# Copy to /etc/wallee/safety.env. Consumed by wallee-safety.service.
# The watchdog reads the shared safety dir under WALLEE_DATA_DIR and the pack
# stop profiles persisted there; it needs no API keys of its own unless a
# profile resolves a host/key by env var (then set those here too).
WALLEE_DATA_DIR=/var/lib/wallee
WALLEE_SAFETY_HEARTBEAT_TIMEOUT_S=30
WALLEE_SAFETY_CHECK_INTERVAL_S=2
WALLEE_SAFETY_RESEND_INTERVAL_S=30
WALLEE_SAFETY_BOOT_GRACE_S=60

# If a pack safety_profile stops via HTTP, the watchdog resolves the host/key
# from these (names come from the pack manifest's safety_profile):
# PRUSA_CORE_ONE_HOST=192.0.2.10
# PRUSA_CORE_ONE_API_KEY=
