# Copy to /etc/wallee/main.env. Consumed by wallee-main.service.
WALLEE_DATA_DIR=/var/lib/wallee
WALLEE_SIMULATION=0
WALLEE_ENABLED_PACKS=prusa_core_one_plus
WALLEE_GOAL=Improve the active print conservatively.

# LLM planner (omit to use the heuristic planner)
WALLEE_PLANNER_BACKEND=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini

# Prusa control surface (the pack safety_profile resolves the stop host/key
# from these names)
PRUSA_CORE_ONE_HOST=192.0.2.10
PRUSA_CORE_ONE_API_KEY=
