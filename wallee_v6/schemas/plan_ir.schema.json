{
  "additionalProperties": false,
  "description": "Canonical planner output contract.\n\nThe planner is allowed to choose frontier action IDs and explain why.\nAnything more expressive than that belongs in deterministic code or in a new\nADR, not in a casual prompt tweak.",
  "properties": {
    "call_human_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Call Human Message"
    },
    "decision": {
      "enum": [
        "NO_ACTION",
        "EXECUTE",
        "CALL_HUMAN"
      ],
      "title": "Decision",
      "type": "string"
    },
    "sequence": {
      "items": {
        "type": "string"
      },
      "title": "Sequence",
      "type": "array"
    },
    "why": {
      "title": "Why",
      "type": "string"
    }
  },
  "required": [
    "decision",
    "why"
  ],
  "title": "PlanIR",
  "type": "object"
}