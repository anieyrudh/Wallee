# Prusa CORE One/+ bring-up environment example
#
# Placeholder values only. Fill these before real-printer smoke.
# Canonical names are `PRUSA_CORE_ONE_*`.
# Exact v5-compatible aliases still supported by code:
# - PRUSALINK_HOST -> PRUSA_CORE_ONE_HOST
# - PRUSALINK_API_KEY -> PRUSA_CORE_ONE_API_KEY
# If both are set, the canonical PRUSA_CORE_ONE_* value wins.

# Managed Wallee runtime
WALLEE_ENABLED_PACKS=prusa_core_one_plus
WALLEE_SIMULATION=0
WALLEE_MONITOR_WHEN_INACTIVE=0
WALLEE_PLANNER_MIN_INTERVAL_S=0.0
WALLEE_PLANNER_VISION_LEAD_S=15.0

# Required for status/files/notebook/lifecycle/speed-trim
# Accepted by code as either:
# - full URL: http://printer.local or https://printer.local
# - bare host/IP: printer.local or 192.0.2.10
# Bare values are normalized to http://...
PRUSA_CORE_ONE_HOST=http://<printer-ip-or-host>

# Optional in code; set it if your PrusaLink instance requires auth.
# Leave blank only if the printer accepts unauthenticated API reads/writes.
PRUSA_CORE_ONE_API_KEY=<prusalink-api-key>

# Optional HTTP tuning
PRUSA_CORE_ONE_HTTP_TIMEOUT_S=2.0
PRUSA_CORE_ONE_STATE_TRANSITION_TIMEOUT_S=8.0
PRUSA_CORE_ONE_STATUS_POLL_INTERVAL_S=0.25

# Notebook build
# Required if you want `build-notebook` to persist <job_hash>.notebook.json.
# Any writable local directory path is accepted.
PRUSA_CORE_ONE_NOTEBOOK_DIR=/absolute/path/to/prusa_notebooks

# Optional for notebook parsing/downloading behavior.
PRUSA_CORE_ONE_ENABLE_GCODE_DOWNLOAD=1
PRUSA_CORE_ONE_NOTEBOOK_LOOKAHEAD_PCT=5.0

# Required for direct speed trim smoke.
# `PRUSA_CORE_ONE_ENABLE_SERIAL=1` and a non-empty device path are both needed.
PRUSA_CORE_ONE_ENABLE_SERIAL=1
PRUSA_CORE_ONE_SERIAL_PORT=/dev/ttyACM0

# Optional serial tuning
PRUSA_CORE_ONE_SERIAL_BAUD=115200
PRUSA_CORE_ONE_SERIAL_TIMEOUT_S=1.0

# Leave this unset in the normal runtime path so vision timing derives from
# planner cadence minus the desired lead time.
# PRUSA_CORE_ONE_VISION_ADVISORY_INTERVAL_S=30.0

# Safety thresholds used by normalization / unload logic.
WALLEE_SAFE_TO_UNLOAD_TEMP_C=35.0
PRUSA_CORE_ONE_SAFE_NOZZLE_TOUCH_C=50.0

# Keep experimental families disabled for main-path bring-up.
PRUSA_CORE_ONE_ENABLE_EXPERIMENTAL_TUNING=0
PRUSA_CORE_ONE_ENABLE_SPEED_TUNING_VERIFICATION=0
PRUSA_CORE_ONE_ENABLE_FLOW_TUNING_VERIFICATION=1

# Optional caps used only if experimental families are enabled later.
PRUSA_CORE_ONE_MAX_NOZZLE_TARGET_C=300.0
PRUSA_CORE_ONE_MAX_BED_TARGET_C=120.0
